# 复制为 .env 后按需修改
PORT=4000

# 数据库
DATABASE_URL="postgresql://paw:paw123456@localhost:5432/paw_print?schema=public"

# 小程序凭据（小程序后台 -> 开发管理 -> 开发设置）
WX_APPID=wxa09c693c405748a8
WX_SECRET=

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=30d

# 本地联调：没有 WX_SECRET 时用它生成假 openid，避免登录链路阻塞
ALLOW_MOCK_LOGIN=true

# 订阅消息模板 ID（小程序后台 -> 订阅消息 -> 我的模板）
# 留空时推送走 mock：只打日志、不真发，方便本地验证链路
WX_SUBSCRIBE_TEMPLATE_ID=
