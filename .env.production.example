# 生产环境变量模板：复制为 .env 后逐项填写
# cp .env.production.example .env && chmod 600 .env

# 服务
PORT=4000
NODE_ENV=production

# 数据库（云数据库或本机 Docker 都行，注意不要用示例密码）
DATABASE_URL="postgresql://paw:换成强密码@127.0.0.1:5432/paw_print?schema=public"

# 小程序凭据：小程序后台 -> 开发管理 -> 开发设置
WX_APPID=wxa09c693c405748a8
WX_SECRET=填真实密钥

# 必须关掉 mock 登录，否则线上不走真实微信登录
ALLOW_MOCK_LOGIN=false

# JWT：用 openssl rand -base64 32 生成，不要用默认值
JWT_SECRET=换成随机长字符串
JWT_EXPIRES_IN=30d

# 订阅消息模板 ID（小程序后台 -> 订阅消息 -> 我的模板）
WX_SUBSCRIBE_TEMPLATE_ID=

# 腾讯位置服务（服务端 key，不是小程序端 key）
LBS_KEY=
